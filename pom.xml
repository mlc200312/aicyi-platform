<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- aicyi 脚手架：插件与公共依赖管理（Java 17 / Lombok / MapStruct 注解处理器 / 构建护栏） -->
    <parent>
        <groupId>io.github.aicyi.base</groupId>
        <artifactId>aicyi-base-starter-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <groupId>io.github.aicyi.cloud</groupId>
    <artifactId>aicyi-platform</artifactId>

    <packaging>pom</packaging>
    <name>aicyi platform</name>
    <description>aicyi platform</description>

    <modules>
        <module>aicyi-admin</module>
        <module>aicyi-auth</module>
        <module>aicyi-gateway</module>
        <module>aicyi-log</module>
        <module>aicyi-message</module>
        <module>aicyi-work-order</module>
    </modules>

    <dependencies>
        <!-- 公共基础库：统一 Result / BaseBean / 异常体系 -->
        <dependency>
            <groupId>io.github.aicyi.common</groupId>
            <artifactId>aicyi-common-model</artifactId>
        </dependency>

        <!-- IJWTInfo 主体接口（Token 体系） -->
        <dependency>
            <groupId>io.github.aicyi.common</groupId>
            <artifactId>aicyi-common-core</artifactId>
        </dependency>

        <!-- StringEnumType Jackson 反序列化器 -->
        <dependency>
            <groupId>io.github.aicyi.common</groupId>
            <artifactId>aicyi-common-util</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- @EnableAspectJAutoProxy 运行期依赖 -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjrt</artifactId>
        </dependency>

        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-resolver-dns-native-macos</artifactId>
            <classifier>osx-x86_64</classifier>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-resolver-dns-native-macos</artifactId>
            <classifier>osx-aarch_64</classifier>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <!-- 统一依赖版本管理：子模块（admin/auth/gateway/log/message/work-order）继承本 POM 即获得，无需重复声明 -->
    <dependencyManagement>
        <dependencies>
            <!-- aicyi 脚手架聚合 BOM：传递管理 common / infra / middleware / framework 全部层级 -->
            <dependency>
                <groupId>io.github.aicyi.framework</groupId>
                <artifactId>aicyi-framework</artifactId>
                <version>0.0.1-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 各服务 Client（Feign 接口契约）：跨服务调用方省略 version -->
            <dependency>
                <groupId>io.github.aicyi.auth</groupId>
                <artifactId>aicyi-auth-client</artifactId>
                <version>0.0.1-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>io.github.aicyi.admin</groupId>
                <artifactId>aicyi-admin-client</artifactId>
                <version>0.0.1-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>io.github.aicyi.workorder</groupId>
                <artifactId>aicyi-work-order-client</artifactId>
                <version>0.0.1-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>io.github.aicyi.log</groupId>
                <artifactId>aicyi-log-client</artifactId>
                <version>0.0.1-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>io.github.aicyi.message</groupId>
                <artifactId>aicyi-message-client</artifactId>
                <version>0.0.1-SNAPSHOT</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
