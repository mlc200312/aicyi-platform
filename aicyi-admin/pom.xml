<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 平台聚合父 POM aicyi-platform：统一 common 依赖 + Spring Cloud / Alibaba / framework BOM 版本管理 -->
    <parent>
        <groupId>io.github.aicyi.cloud</groupId>
        <artifactId>aicyi-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>io.github.aicyi.admin</groupId>
    <artifactId>aicyi-admin</artifactId>

    <packaging>pom</packaging>
    <name>aicyi admin</name>
    <description>aicyi admin service</description>

    <modules>
        <module>aicyi-admin-client</module>
        <module>aicyi-admin-domain</module>
        <module>aicyi-admin-dao</module>
        <module>aicyi-admin-service</module>
        <module>aicyi-admin-web</module>
        <module>aicyi-admin-boot</module>
    </modules>

    <!-- 公共依赖（common-model/core/util、lombok、aspectj、spring-boot-starter）已由父 POM aicyi-platform 统一继承提供 -->

    <dependencyManagement>
        <dependencies>
        <!-- 本工程子模块版本（BOM 由父 POM aicyi-platform 统一管理） -->
        <dependency>
                <groupId>io.github.aicyi.admin</groupId>
                <artifactId>aicyi-admin-domain</artifactId>
                <version>0.0.1-SNAPSHOT</version>
            </dependency>

        <dependency>
                <groupId>io.github.aicyi.admin</groupId>
                <artifactId>aicyi-admin-dao</artifactId>
                <version>0.0.1-SNAPSHOT</version>
            </dependency>

        <dependency>
                <groupId>io.github.aicyi.admin</groupId>
                <artifactId>aicyi-admin-service</artifactId>
                <version>0.0.1-SNAPSHOT</version>
            </dependency>

        <dependency>
                <groupId>io.github.aicyi.admin</groupId>
                <artifactId>aicyi-admin-web</artifactId>
                <version>0.0.1-SNAPSHOT</version>
            </dependency>

        <dependency>
                <groupId>io.github.aicyi.admin</groupId>
                <artifactId>aicyi-admin-boot</artifactId>
                <version>0.0.1-SNAPSHOT</version>
            </dependency>

        <dependency>
                <groupId>io.github.aicyi.admin</groupId>
                <artifactId>aicyi-admin-client</artifactId>
                <version>0.0.1-SNAPSHOT</version>
            </dependency>
    </dependencies>
    </dependencyManagement>
</project>
