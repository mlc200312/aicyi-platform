<?xml version="1.0" encoding="UTF-8"?>
<!--
  复用 aicyi 基础包默认日志配置（appender 分类 + traceId pattern）。
  基础包不再随 jar 分发根级 logback-spring.xml，由应用显式 opt-in 引入。
  aicyi.logging.* 配置项仍可在应用配置中覆盖（路径/保留天数/单文件大小/总容量）。
-->
<configuration scan="true">
    <include resource="aicyi/logback-aicyi-defaults.xml"/>

    <!-- 覆盖：ACCESS 日志同时进控制台（仍保留 access.log） -->
    <logger name="ACCESS" level="info" additivity="false">
        <appender-ref ref="accessAppender"/>
        <appender-ref ref="STDOUT"/>
    </logger>
</configuration>
