<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.aicyi.admin</groupId>
        <artifactId>aicyi-admin</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>aicyi-admin-service</artifactId>
    <packaging>jar</packaging>
    <name>aicyi admin service</name>
    <description>业务逻辑层</description>

    <dependencies>
        <dependency>
            <groupId>io.github.aicyi.admin</groupId>
            <artifactId>aicyi-admin-dao</artifactId>
        </dependency>

        <!-- Redis 会话/权限缓存（StringRedisTemplate；aicyi-midware-redis 为 optional，需显式引入） -->
        <dependency>
            <groupId>io.github.aicyi.infra</groupId>
            <artifactId>aicyi-infra-redis</artifactId>
        </dependency>

        <!-- 邮件 / 短信渠道发送器（消息 starter 中为 optional，需显式引入；MQ 渠道按需另行引入） -->
        <dependency>
            <groupId>io.github.aicyi.infra</groupId>
            <artifactId>aicyi-infra-message-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.aicyi.infra</groupId>
            <artifactId>aicyi-infra-message-sms</artifactId>
        </dependency>

        <!-- 操作日志审计组件：@OperLog 注解 / AOP 切面 / SysOperLogMapper（aicyi-midware-spring-boot-starter 中为 optional，需显式引入） -->
        <dependency>
            <groupId>io.github.aicyi.middleware</groupId>
            <artifactId>aicyi-middleware-operatelog</artifactId>
        </dependency>

        <!-- BCrypt 密码加密（spring-security-crypto，仅加密组件，不含过滤器链） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Excel 解析（aicyi-common-util 中为 optional，需显式引入）：批量导入读取用户数据行 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
        </dependency>
    </dependencies>
</project>
