            <groupId>io.github.aicyi.infra</groupId>
            <artifactId>aicyi-infra-mybatis-plus</artifactId>
        </dependency>

        <!-- Excel 注解（@ExcelProperty，aicyi-common-util 中为 optional，需显式引入）：用户导入模板行模型 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
        </dependency>
    </dependencies>
</project>